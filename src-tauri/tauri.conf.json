{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gemini Router",
  "version": "0.1.2",
  "identifier": "dev.gemini-router.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gemini Router",
        "width": 1180,
        "height": 880,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
